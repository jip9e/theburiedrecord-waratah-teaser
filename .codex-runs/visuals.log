from decimal import Decimal
from pathlib import Path
class Root(HTMLParser):
 def __init__(self):
  super().__init__(); self.current=Decimal(0); self.visuals=[]
 def handle_starttag(self, tag, pairs):
  attrs=dict(pairs)
  if attrs.get('id')=='main': assert attrs['data-duration']=='55' and (attrs['data-width'],attrs['data-height'])==('1920','1080')
  if attrs.get('data-composition-src') or attrs.get('id')=='silence':
   t=Decimal(attrs['data-start']); end=t+Decimal(attrs['data-duration']); assert t==self.current; self.current=end
   if path:=attrs.get('data-composition-src'): assert Path(path).is_file()
   assert attrs['class']=='clip'
   self.visuals.append((attrs['id'],str(t),str(end)))
p=Root(); p.feed(Path('index.html').read_text()); assert p.current==55
for window in p.visuals: print(*window)

from pathlib import Path
from shutil import copyfile
from PIL import Image, ImageDraw

directory = Path('out/visuals-review')
for refined in Path('/tmp/waratah-refined-frames').glob('frame-*.png'):
    suffix = refined.name.split('-at-')[1]
    original, = directory.glob(f'frame-*-at-{suffix}')
    copyfile(refined, original)

frames = sorted(directory.glob('frame-*.png'))
assert len(frames) == 12
assert Image.open(frames[7]).convert('RGB').getextrema() == ((0, 0), (0, 0), (0, 0))
sheet = Image.new('RGB', (1440, 1152), '#171717')
labels = ImageDraw.Draw(sheet)
for i, frame in enumerate(frames):
    x, y = i % 3 * 480, i // 3 * 288
    with Image.open(frame) as image:
        image.thumbnail((480, 270), Image.Resampling.LANCZOS)
        sheet.paste(image, (x, y))
    labels.text((x + 7, y + 272), frame.stem.split('-at-')[1], fill='white')
sheet.save(directory / 'contact-sheet.jpg', quality=94)
for stale in directory.glob('contact-sheet-*.jpg'):
    stale.unlink()
PY

  tl.fromTo("#s5-cam",{y:0},{y:220,duration:0.45,ease:"power2.in"},5.75);
  tl.fromTo("#s5-line-in",{opacity:1},{opacity:0,duration:0.3,ease:"power2.in"},5.7);
  tl.fromTo("#s5-black",{opacity:0},{opacity:1,duration:0.4,ease:"power2.in"},5.8);

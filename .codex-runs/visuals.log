import wave
from array import array
import math
p='assets/sfx/mix_v2.wav'
with wave.open(p,'rb') as audio:
    print(f'Mix length {audio.getnframes()/audio.getframerate():.3f}s')
    for start,end in [(35.06,37.75),(35.45,37.70),(52.2,52.64)]:
        audio.setpos(round(start*audio.getframerate()))
        pcm=array('h',audio.readframes(round((end-start)*audio.getframerate())))
        peak=max(abs(v) for v in pcm)
        rms=math.sqrt(sum(v*v for v in pcm)/len(pcm))
        print(f'{start:.2f}-{end:.2f}s peak {20*math.log10(peak/32768):.1f} dBFS, RMS {20*math.log10(rms/32768):.1f} dBFS')

  tl.fromTo("#s5-brand",{scale:1},{scale:1.03,duration:1.1,ease:"none"},8.0);
  tl.fromTo("#s5-brule",{scaleX:0},{scaleX:1,duration:0.5,ease:"expo.out"},7.6);

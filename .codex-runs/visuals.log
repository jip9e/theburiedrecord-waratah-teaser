from PIL import Image
import numpy as np

logo = np.asarray(Image.open('assets/brand/logo.png').convert('RGB')).astype(float)
bg = np.array([16, 13, 12])
colors = np.array([[232, 218, 190], [185, 143, 77], [137, 42, 30]])
delta = logo - bg
vectors = colors - bg
alpha_options = np.clip(np.einsum('hwc,kc->hwk', delta, vectors) / (vectors**2).sum(axis=1), 0, 1)
residual = delta[:, :, None, :] - alpha_options[:, :, :, None] * vectors
nearest = (residual**2).sum(axis=3).argmin(axis=2)
alpha = np.take_along_axis(alpha_options, nearest[:, :, None], axis=2)[:, :, 0]
# Interior paint is opaque. Estimate alpha only along the antialiased matte edge.
alpha[np.max(abs(delta), axis=2) < 9] = 0
alpha[alpha > 0.84] = 1
clean = np.clip(bg + delta / np.maximum(alpha[:, :, None], 0.001), 0, 255)
rgba = np.dstack((clean, alpha * 255)).round().astype('uint8')
im = Image.fromarray(rgba)
